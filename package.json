{
  "name": "elid-wasm",
  "version": "0.1.0",
  "description": "Fast string similarity library for JavaScript - WebAssembly bindings for ELID",
  "main": "pkg/elid.js",
  "types": "pkg/elid.d.ts",
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir pkg",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node",
    "build:web": "wasm-pack build --target web --out-dir pkg-web",
    "build:all": "npm run build && npm run build:node && npm run build:web",
    "test": "wasm-pack test --node --features wasm",
    "pack": "wasm-pack pack pkg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZachHandley/ELID.git"
  },
  "keywords": [
    "string-similarity",
    "levenshtein",
    "fuzzy-search",
    "fuzzy-matching",
    "jaro-winkler",
    "hamming",
    "distance",
    "wasm",
    "webassembly",
    "rust"
  ],
  "author": "ELID Contributors",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/ZachHandley/ELID/issues"
  },
  "homepage": "https://github.com/ZachHandley/ELID#readme",
  "devDependencies": {
    "wasm-pack": "^0.12.0"
  }
}
