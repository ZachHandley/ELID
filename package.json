{
  "name": "elid-wasm",
  "version": "0.0.0-dev",
  "description": "Embedding Locality IDentifier - encode embeddings into sortable string IDs for vector search, plus fast string similarity algorithms (WASM)",
  "main": "pkg/elid.js",
  "types": "pkg/elid.d.ts",
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "wasm-pack build --target bundler --out-dir pkg -- --features wasm",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node -- --features wasm",
    "build:web": "wasm-pack build --target web --out-dir pkg-web -- --features wasm",
    "build:all": "npm run build && npm run build:node && npm run build:web",
    "test": "wasm-pack test --node --features wasm",
    "test:node": "node tests/wasm/test-node.js",
    "test:bundler": "node tests/wasm/test-bundler.mjs",
    "test:all": "npm run test:node && npm run test:bundler",
    "pack": "wasm-pack pack pkg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZachHandley/ELID.git"
  },
  "keywords": [
    "embeddings",
    "vector-search",
    "locality-sensitive-hashing",
    "string-similarity",
    "levenshtein",
    "fuzzy-search",
    "jaro-winkler",
    "wasm",
    "webassembly",
    "rust"
  ],
  "author": "Zach Handley <zachhandley@gmail.com>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/ZachHandley/ELID/issues"
  },
  "homepage": "https://github.com/ZachHandley/ELID#readme",
  "devDependencies": {
    "wasm-pack": "^0.12.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
