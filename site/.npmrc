# pnpm reads .npmrc unconditionally from cwd up to home, regardless of
# pnpm version or which directory you invoke from. site/pnpm-workspace.yaml
# was being silently dropped by pnpm 11 even with packages: ['.'], leaving
# esbuild + sharp install scripts unapproved and the build failing with
# ERR_PNPM_IGNORED_BUILDS. Putting the allowlist here works around that
# and also covers the case where Astro internally spawns its own pnpm.

# Allow the build scripts we actually want to run (sharp needs its native
# binary or astro:image breaks; esbuild needs its platform binary).
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp

# Don't hard-fail when transitive deps add new build-script-having packages
# that aren't in the allowlist above; pnpm just warns and skips them.
strict-dep-builds=false
