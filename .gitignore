# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/

# IDE and editor files
.vscode/
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log

# Profiling data
*.prof
*.profraw
*.profdata

# Library artifacts
*.rlib

# Model caches
.fastembed_cache/
models/

# Language-specific binding artifacts

# Python (PyO3)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.venv/
venv/
pip-wheel-metadata/

# Node.js/TypeScript (napi-rs)
node_modules/
*.node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
dist/
build/

# Dart/Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock
*.iml

# Swift
.build/
DerivedData/
*.swiftpm/
Packages/
*.xcodeproj/
*.xcworkspace/

# Kotlin/Android
.gradle/
local.properties
*.apk
*.aab
*.aar
*.class
*.jar
captures/
.externalNativeBuild/
.cxx/

# Ruby
.bundle/
vendor/bundle/
*.gem
.ruby-version

# PHP
vendor/
composer.lock
*.cache

# UniFFI generated files
**/generated/

# Binding-specific build artifacts
bindings/**/target/
bindings/**/dist/
bindings/**/build/
bindings/**/*.so
bindings/**/*.dylib
bindings/**/*.dll
bindings/**/*.a
